# Appwrite (self-hosted) — these are embedded in the client bundle, not secret.
# Copy this file to .env and fill in the values from your Appwrite Console.
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://your-appwrite-host/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=
EXPO_PUBLIC_APPWRITE_DATABASE_ID=
EXPO_PUBLIC_APPWRITE_SETTINGS_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_RECORDINGS_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_SEGMENTS_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_BUCKET_ID=
